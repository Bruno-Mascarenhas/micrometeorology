# ==============================================================================
# Python / Build / OS
# ==============================================================================
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
*.egg
dist/
build/
*.whl
.eggs/
.DS_Store
Thumbs.db

# ==============================================================================
# Environment & Secrets
# ==============================================================================
.env
.env.local
.env.*
!.env.example

# ==============================================================================
# Virtual Environments
# ==============================================================================
.venv/
venv/
env/

# ==============================================================================
# Testing & Coverage
# ==============================================================================
.coverage
htmlcov/
coverage.xml
*.log

# ==============================================================================
# Caching & Temp Files
# ==============================================================================
.mypy_cache/
.ruff_cache/
.uv-cache/
.pytest_cache/
.pytest_tmp*/
scratch/
.ipynb_checkpoints/
.jupyter/
# Generated by `make audit` / the CI vulnerability gate
requirements-audit.txt
# Ad-hoc tool output dumps (mypy_output.txt and friends) never belong in git
*_output.txt
# Frame dumps written at the repo root while verifying a pipeline by hand. A
# 60 MB CSV of the hourly archive reached a commit this way; the artifacts have
# a home under /output/, and nothing generically named belongs at the root.
/full.csv
/*.parquet

# ==============================================================================
# IDE / Editor (Local only)
# ==============================================================================
# Ignore IDE folders except intentionally shared workspace settings
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*~

# ==============================================================================
# Data Files (Raw / Temporary / Large)
# ==============================================================================
/data/
/logs/
/runs/
/tb_logs/
*.nc
*.nc4
*.h5
*.hdf
*.hdf5
# Datalogger exports, wherever they land: `/data/**/*.dat` covered the archive
# copy alone, and a TOA5 file pulled into the working tree to inspect it is the
# one that gets committed by accident. No .dat in this repo is source.
*.dat
# Acquisition CSVs. Narrower than `*.csv`, which would swallow the small
# fixtures the test suite ships: these are the shapes the pipelines write.
*_hourly.csv
*_5min.csv
station-*.csv
series_operacional*.csv
# All-sky camera videos (also under /data, but stray copies land elsewhere too,
# e.g. Colab /content) — one-day timelapses are large binaries.
*.mp4

# ==============================================================================
# ML / Experiment Artifacts
# ==============================================================================
/output/
*.pt
*.pth
*.ckpt
*.npy
*.joblib
*.pkl
# Precomputed visual-embedding shards (allsky multimodal pipeline). These live
# under /output today but are ignored globally so scratch/exported shards never
# get committed.
*.safetensors


# ==============================================================================
# Output Images
# ==============================================================================
# Prevent accidental tracking of generated map figures
/output/**/*.jpg
/output/**/*.jpeg
/output/**/*.png
/output/**/*.gif
/output/**/*.bmp

# ==============================================================================
# Notas de arqueologia do acervo (locais, não versionadas)
# ==============================================================================
# Documentação de estudo sobre como o acervo de sensores foi auditado. Fica fora
# do git por descrever o conteúdo e as falhas da base científica do laboratório.
/ARQUEOLOGIA-DO-ACERVO.md
/docs/arqueologia/
